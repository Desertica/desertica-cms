# Servidor
HOST=0.0.0.0
PORT=1337
# URL publica del CMS (usada para URLs absolutas); dejar vacio en local
PUBLIC_URL=http://localhost:1337
# Secretos (generar con: openssl rand -base64 16). APP_KEYS = 4 valores separados por coma
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
ENCRYPTION_KEY=changeMe
JWT_SECRET=changeMe

# Base de datos: sqlite (por defecto) o postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Solo postgres:
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=desertica
DATABASE_USERNAME=desertica
DATABASE_PASSWORD=
DATABASE_SSL=false

# Origenes permitidos por CORS (lista separada por comas)
CLIENT_URLS=http://localhost:4200,http://localhost:4000

# Sembrar el catalogo si no hay destinos (cms/seed/catalog.json). Usar false para desactivar
SEED_ON_EMPTY=true

# Locale por defecto de i18n al crear la base de datos
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# Secreto compartido con el servidor Express de Angular (FORMS_PROXY_SECRET alli tambien).
# Permite que el limite de peticiones use la IP real del visitante en vez de la del proxy.
FORMS_PROXY_SECRET=
