# Servidor
HOST=0.0.0.0
PORT=1337
# URL publica del CMS (https://cms.example.com). Define la URL del admin; NO vuelve absolutas las URLs de /uploads.
PUBLIC_URL=http://localhost:1337
# true si hay un proxy inverso con TLS delante (confia en X-Forwarded-*). false si se expone directo.
PROXY=false
# Secretos (generar con: openssl rand -base64 16). APP_KEYS = 4 valores separados por coma
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
ENCRYPTION_KEY=changeMe
JWT_SECRET=changeMe

# Base de datos: sqlite (por defecto) o postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Solo postgres:
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=desertica
DATABASE_USERNAME=desertica
DATABASE_PASSWORD=
DATABASE_SSL=false

# Docker Compose: puerto publicado en el host (el contenedor siempre escucha en 1337).
# DATABASE_PASSWORD es obligatorio con docker-compose.yml (lo usan cms y postgres).
CMS_HOST_PORT=1337

# Origenes permitidos por CORS (lista separada por comas)
CLIENT_URLS=http://localhost:4200,http://localhost:4000

# Sembrar el catalogo si no hay destinos (cms/seed/catalog.json). Usar false para desactivar
SEED_ON_EMPTY=true

# Medios: tamano maximo por archivo en MB (body + plugin upload) y hosts extra para la CSP (lista con comas)
UPLOAD_MAX_FILE_SIZE_MB=200
MEDIA_HOSTS=

# Libreria de medios: local (public/uploads, por defecto) o aws-s3 (S3, R2, MinIO, Spaces...)
UPLOAD_PROVIDER=local
# Solo con UPLOAD_PROVIDER=aws-s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Vacio = AWS. Para R2/MinIO/Spaces: https://<host>
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# URL publica del bucket o CDN (sin barra final); es el prefijo de las URLs de los medios
S3_PUBLIC_URL=
S3_ROOT_PATH=
# Vacio si el bucket tiene ACL desactivadas; public-read si las usa
S3_ACL=

# Locale por defecto de i18n al crear la base de datos
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# Secreto compartido con el servidor Express de Angular (FORMS_PROXY_SECRET alli tambien).
# Permite que el limite de peticiones use la IP real del visitante en vez de la del proxy.
FORMS_PROXY_SECRET=
