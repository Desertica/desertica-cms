# ============ Obligatorias ============
# Servidor
HOST=0.0.0.0
PORT=1337
# URL publica del CMS (https://cms.example.com). Define la URL del admin; NO vuelve absolutas las URLs de /uploads.
PUBLIC_URL=http://localhost:1337
# true si hay un proxy inverso con TLS delante (confia en X-Forwarded-*). false si se expone directo.
PROXY=false
# Secretos (generar con: openssl rand -base64 16). APP_KEYS = 4 valores separados por coma
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
ENCRYPTION_KEY=changeMe
JWT_SECRET=changeMe

# Base de datos: sqlite (por defecto) o postgres
DATABASE_CLIENT=sqlite
# Postgres en plataformas gestionadas (Railway, Render...): una sola URL; tiene prioridad sobre DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD
# DATABASE_URL=postgres://usuario:clave@host:5432/base
DATABASE_FILENAME=.tmp/data.db
# Solo postgres:
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=desertica
DATABASE_USERNAME=desertica
DATABASE_PASSWORD=
DATABASE_SSL=false
# Docker Compose: puerto publicado en el host (el contenedor siempre escucha en 1337).
# DATABASE_PASSWORD es obligatorio con docker-compose.yml (lo usan cms y postgres).
CMS_HOST_PORT=1337

# Origenes permitidos por CORS (lista separada por comas). El PRIMERO es la web: el boton "Vista previa" del editor
# la abre alli y la firma con FORMS_PROXY_SECRET (no hay variables de vista previa aparte).
CLIENT_URLS=http://localhost:4200,http://localhost:4000

# Secreto compartido con el servidor Express de Angular (FORMS_PROXY_SECRET alli tambien). Lo usan el limite de peticiones
# (IP real del visitante) y la firma de la vista previa.
FORMS_PROXY_SECRET=

# Siembra el catalogo (seed/catalog.json) en una base que nunca se sembro: una vez, y queda marcada en la base
# (`catalog-seeded`), asi que despublicar o borrar todos los destinos no lo vuelve a sembrar. Las paginas legales
# se siembran en borrador. Poner false despues del primer arranque en staging y produccion.
SEED_ON_EMPTY=true

# ============ Opcionales: correo ============
# Aviso por correo de cada reserva y mensaje nuevo: se envia solo si esta SMTP_HOST, al correo de "Datos de la empresa"
# del panel y desde SMTP_USER. Un fallo de envio solo se registra; nunca afecta al formulario de la web.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Solo si el proveedor lo pide (por defecto 587 con STARTTLS; SMTP_SECURE=true para el 465 con TLS directo):
# SMTP_PORT=587
# SMTP_SECURE=false

# ============ Opcionales: traduccion ============
# Traduccion automatica (panel "Traduccion automatica" y borrador en ingles al publicar en espanol). Clave de DeepL de
# deepl.com/pro-api; las que terminan en ":fx" son del plan gratis y usan api-free.deepl.com. Sin clave no se traduce.
DEEPL_API_KEY=
# Opcional: otro endpoint de DeepL (proxy propio o pruebas).
DEEPL_API_URL=

# ============ Opcionales: almacenamiento ============
# Medios: tamano maximo por archivo en MB (body + plugin upload) y hosts extra para la CSP (lista con comas)
UPLOAD_MAX_FILE_SIZE_MB=200
MEDIA_HOSTS=
# Libreria de medios: local (public/uploads, por defecto) o aws-s3 (S3, R2, MinIO, Spaces...)
UPLOAD_PROVIDER=local
# Solo con UPLOAD_PROVIDER=aws-s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Vacio = AWS. Para R2/MinIO/Spaces: https://<host>
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# URL publica del bucket o CDN (sin barra final); es el prefijo de las URLs de los medios
S3_PUBLIC_URL=
S3_ROOT_PATH=
# Vacio si el bucket tiene ACL desactivadas; public-read si las usa
S3_ACL=

# ============ Solo staging / desarrollo ============
# Crea un tour con todos los campos llenos de lorem ipsum (y un PDF de ejemplo) para que el equipo lo copie. No en produccion.
SEED_SAMPLE_TOUR=false
# Locale por defecto de i18n al crear la base de datos
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en
