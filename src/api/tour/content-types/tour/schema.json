{
  "kind": "collectionType",
  "collectionName": "tours",
  "info": {
    "singularName": "tour",
    "pluralName": "tours",
    "displayName": "Tour"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "uid",
      "required": true
    },
    "order": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "integer",
      "default": 0
    },
    "durationHours": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "integer",
      "required": true,
      "min": 1
    },
    "priceFrom": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "float",
      "required": true,
      "min": 0
    },
    "featured": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "boolean",
      "default": false
    },
    "format": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "enumeration",
      "enum": [
        "shared",
        "private",
        "both"
      ],
      "default": "both"
    },
    "languages": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "json",
      "default": [
        "es",
        "en"
      ]
    },
    "imageUrl": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string"
    },
    "image": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "galleryUrls": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "json"
    },
    "gallery": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "portraitUrls": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "json"
    },
    "portraits": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "destination": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::destination.destination",
      "inversedBy": "tours"
    },
    "title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "lead": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "lead2": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "meeting": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "highlights": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },
    "practices": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.feature"
    },
    "itinerary": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.stop"
    },
    "included": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "excluded": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "pack": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "notes": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    }
  }
}
