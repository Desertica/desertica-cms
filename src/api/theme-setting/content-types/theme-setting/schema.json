{
  "kind": "singleType",
  "collectionName": "theme_settings",
  "info": {
    "singularName": "theme-setting",
    "pluralName": "theme-settings",
    "displayName": "Sitio — Colores y estilo",
    "description": "Colors (light and dark), fonts, corner radius, header size and intro animation."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "light": {
      "type": "component",
      "repeatable": false,
      "component": "theme.palette",
      "required": true
    },
    "dark": {
      "type": "component",
      "repeatable": false,
      "component": "theme.palette",
      "required": true
    },
    "fontSans": {
      "type": "enumeration",
      "enum": [
        "radio-canada",
        "inter",
        "poppins",
        "montserrat",
        "dm-sans",
        "playfair-display",
        "lora",
        "merriweather",
        "system"
      ],
      "default": "radio-canada",
      "required": true
    },
    "fontHeading": {
      "type": "enumeration",
      "enum": [
        "radio-canada",
        "inter",
        "poppins",
        "montserrat",
        "dm-sans",
        "playfair-display",
        "lora",
        "merriweather",
        "system"
      ],
      "default": "radio-canada",
      "required": true
    },
    "radius": {
      "type": "enumeration",
      "enum": [
        "none",
        "small",
        "medium",
        "large",
        "full"
      ],
      "default": "medium",
      "required": true
    },
    "headerSize": {
      "type": "enumeration",
      "enum": [
        "compact",
        "standard",
        "tall"
      ],
      "default": "standard",
      "required": true
    },
    "introEnabled": {
      "type": "boolean",
      "default": true
    },
    "introAccent": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "options": {
        "format": "hex"
      },
      "default": "#5a6b3e",
      "regex": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "introRestScale": {
      "type": "decimal",
      "default": 0.85,
      "min": 0.1,
      "max": 1
    },
    "introFailsafeMs": {
      "type": "integer",
      "default": 12000,
      "min": 1000,
      "max": 30000
    }
  }
}
