{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Sitio — Datos de la empresa",
    "description": "Contact details, social links, legal entity, brand name, default share image and placeholder image."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string",
      "regex": "^[0-9X+()\\- ]{6,20}$"
    },
    "whatsapp": {
      "type": "string",
      "regex": "^[0-9X]{8,15}$"
    },
    "instagram": {
      "type": "string"
    },
    "showInstagram": {
      "type": "boolean",
      "default": false
    },
    "facebook": {
      "type": "string"
    },
    "showFacebook": {
      "type": "boolean",
      "default": false
    },
    "tiktok": {
      "type": "string"
    },
    "showTiktok": {
      "type": "boolean",
      "default": false
    },
    "youtube": {
      "type": "string"
    },
    "showYoutube": {
      "type": "boolean",
      "default": false
    },
    "linkedin": {
      "type": "string"
    },
    "showLinkedin": {
      "type": "boolean",
      "default": false
    },
    "google": {
      "type": "string"
    },
    "showGoogle": {
      "type": "boolean",
      "default": false
    },
    "tripadvisor": {
      "type": "string"
    },
    "showTripadvisor": {
      "type": "boolean",
      "default": false
    },
    "legalName": {
      "type": "string"
    },
    "ruc": {
      "type": "string",
      "regex": "^[0-9X]{11}$"
    },
    "brandName": {
      "type": "string",
      "default": "Desértica"
    },
    "legalYear": {
      "type": "integer",
      "default": 2026
    },
    "shareImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "shareImageUrl": {
      "type": "string"
    },
    "placeholderImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
